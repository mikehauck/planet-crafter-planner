// Game data extracted from The Planet Crafter (see scripts/extract/README.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Anything that can be crafted or built, plus the raw resources recipes use.
model Item {
  /// The game's own id, e.g. "OreExtractor2"
  id     String  @id
  /// Not unique: a retired item may share a name with a current one. The seed file checks names are unique.
  name   String
  /// Resource, Component, Item, Equipment, Machine, Base Building, ...
  type   String
  /// Comma-separated planets this unlocks on; empty means every planet
  planet String  @default("")
  /// What it produces in the terraformation: Energy, Oxygen, Heat, Pressure, Plants, Insects, Animals, Purification
  categories String[] @default([])
  /// Set when a game data import no longer has this item. Kept, not deleted, so plans that use it still work.
  retiredAt  DateTime? @map("retired_at")

  ingredients RecipeIngredient[] @relation("recipe")
  usedIn      RecipeIngredient[] @relation("ingredient")

  @@map("items")
}

/// One line of a recipe: `qty` of `ingredient` goes into one `item`.
model RecipeIngredient {
  itemId       String @map("item_id")
  ingredientId String @map("ingredient_id")
  qty          Int

  item       Item @relation("recipe", fields: [itemId], references: [id], onDelete: Cascade)
  ingredient Item @relation("ingredient", fields: [ingredientId], references: [id])

  @@id([itemId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}
