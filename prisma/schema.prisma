// Game data extracted from The Planet Crafter (see scripts/extract/README.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Anything that can be crafted or built, plus the raw resources recipes use.

model Item {
  /// The game's own id, e.g. "OreExtractor2"
  id         String    @id
  /// Not unique: a retired item may share a name with a current one. The seed file checks names are unique.
  name       String
  /// Resource, Component, Item, Equipment, Machine, Base Building, ...
  type       String
  /// Comma-separated planets this unlocks on; empty means every planet
  planet     String    @default("")
  /// What it produces in the terraformation: Energy, Oxygen, Heat, Pressure, Plants, Insects, Animals, Purification
  categories String[]  @default([])
  /// Set when a game data import no longer has this item. Kept, not deleted, so plans that use it still work.
  retiredAt  DateTime? @map("retired_at")

  ingredients RecipeIngredient[] @relation("recipe")
  usedIn      RecipeIngredient[] @relation("ingredient")
  planItems   PlanItem[]

  @@map("items")
}

/// One line of a recipe: `qty` of `ingredient` goes into one `item`.

model RecipeIngredient {
  itemId       String @map("item_id")
  ingredientId String @map("ingredient_id")
  qty          Int

  item       Item @relation("recipe", fields: [itemId], references: [id], onDelete: Cascade)
  ingredient Item @relation("ingredient", fields: [ingredientId], references: [id])

  @@id([itemId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

/// Better Auth tables (generated by `pnpm dlx auth@1.7.7 generate`, then mapped to snake_case).
/// `role` comes from the admin plugin: "user" or "admin".
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires")
  sessions      Session[]
  accounts      Account[]
  plans         Plan[]

  @@unique([email])
  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime @map("expires_at")
  token          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @map("impersonated_by")

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// A user's named plan. Signed-out visitors keep theirs in localStorage instead.
model Plan {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  name      String
  /// items counted as themselves in the totals, not broken down into what they are made of
  keepWhole String[]   @default([]) @map("keep_whole")
  /// totals drawer: true shows raw resources, false one level down
  rawOnly   Boolean    @default(true) @map("raw_only")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     PlanItem[]

  @@unique([userId, name])
  @@map("plans")
}

/// `qty` of `item` to build in a plan. Items are never deleted (imports retire them), so Restrict is safe.
model PlanItem {
  planId String @map("plan_id")
  itemId String @map("item_id")
  qty    Int
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([planId, itemId])
  @@index([itemId])
  @@map("plan_items")
}
